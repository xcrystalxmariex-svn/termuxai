{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {},
      "prebuildCommand": "cd frontend && npm install --package-lock-only --legacy-peer-deps"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "prebuildCommand": "cd frontend && npm install --package-lock-only --legacy-peer-deps"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
